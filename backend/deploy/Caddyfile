# Beautybook на своём сервере: сайт и API на одном адресе. HTTPS-сертификат Caddy получает и продлевает сам
# (Let's Encrypt). {{DOMAIN}} подставляет install.sh. Журнала посещений нет: в адресах бывают личные ссылки клиентов.
{{DOMAIN}} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * /opt/beautybook/frontend
		header Cache-Control "no-cache"
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

www.{{DOMAIN}} {
	redir https://{{DOMAIN}}{uri} permanent
}
